# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- CockroachDB (the memory layer) ---
# From the CockroachDB Cloud console, or `ccloud cluster sql-connection-string`.
# Format: postgresql://<user>:<password>@<host>:26257/<db>?sslmode=verify-full
COCKROACH_DATABASE_URL=postgresql://user:password@localhost:26257/brasstacks?sslmode=disable

# Cluster identity, used by the ccloud CLI setup scripts.
CCLOUD_CLUSTER_NAME=brasstacks

# --- The Ask agent, over CockroachDB's managed MCP server ---
# The owner asks a question; the agent answers it by querying the live cluster
# read-only. This is the second CockroachDB tool used at runtime.
#
# The token is a Cloud service account API key. Create the service account in
# the CockroachDB Cloud Console, scope its RBAC to this cluster, and copy the
# key out of the generated MCP config snippet. Read-only is the server default
# and we never grant write consent.
#
# The service account needs the Cloud RBAC role **Cluster Operator**, scoped to
# this cluster. Cluster Developer is NOT enough and fails quietly: the key
# authenticates fine (HTTP 200), the cluster list comes back empty, and the
# agent reports it cannot find any database. Check with:
#   curl -s https://cockroachlabs.cloud/api/v1/clusters \
#     -H "Authorization: Bearer $COCKROACH_MCP_TOKEN" | jq '.clusters | length'
#
# Leave the token blank and the nightly loop still runs — only Ask is disabled.
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_TOKEN=

# Not secrets — identifiers. Supplying them lets the Ask agent skip cluster and
# schema discovery, which it otherwise repeats on every single question.
# Measured against the live cluster: 8 tool calls per question without them,
# 2 with. Find the id via the curl above, or the Cloud Console URL.
COCKROACH_CLUSTER_ID=
COCKROACH_DATABASE=defaultdb

# --- AWS ---
AWS_REGION=us-east-1

# --- Reasoning model ---
# Which provider the agents reason through: "anthropic" (direct API) or
# "bedrock" (Claude hosted on Bedrock). Bedrock is unavailable on this account —
# see CLAUDE.md "Model access" — so the default is the direct API.
MODEL_PROVIDER=anthropic

# Direct Anthropic API. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-5

# Only used when MODEL_PROVIDER=bedrock. Note the `anthropic.` prefix — Bedrock
# model IDs are NOT the bare first-party IDs.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Embeddings, via boto3 bedrock-runtime. Titan is an AWS model, so no prefix.
# Output dimension must match VECTOR(1024) in db/schema.sql.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# Maker artifacts (menus, draft replies).
S3_ARTIFACT_BUCKET=brasstacks-artifacts-changeme

# --- Demo tenant ---
# The single business the demo runs against. Populated by db/seed.
BRASSTACKS_BUSINESS_ID=

# --- Radar's outside-world signal ---
# A legitimate search API, since scraping review sites violates their ToS.
SEARCH_API_KEY=

# --- Yelp Fusion (opt-in: `python -m brasstacks.night --yelp`) ---
# Real reviews for a real business. Off by default for two reasons, and both
# are worth reading before you turn it on:
#
# 1. RETENTION IS CAPPED AT 24 HOURS. Yelp's API Terms of Use forbid storing
#    their content longer than that. Radar therefore deletes Yelp-sourced
#    observations older than 24h on every run. Yelp informs the night it is
#    seen and then goes — it never becomes the long memory the rest of the
#    product is built on. This is a licence term, not a tunable.
#
# 2. THE DEMO TENANT IS FICTIONAL. Rosa's Trattoria has no Yelp presence, so
#    this returns nothing for it. Pointing it at a real restaurant would drag
#    a business you do not own into a public submission.
#
# Also note Yelp returns 3 review excerpts truncated to 160 characters, chosen
# by their ranking — a trickle of recent sentiment, not a corpus.
YELP_API_KEY=
