# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- CockroachDB (the memory layer) ---
# From the CockroachDB Cloud console, or `ccloud cluster sql-connection-string`.
# Format: postgresql://<user>:<password>@<host>:26257/<db>?sslmode=verify-full
#
# LEAVE `sslrootcert` OFF. The console hands you a connection string ending in
# `&sslrootcert=<some path on the machine that generated it>`; delete that part.
# The cluster presents an ordinary Let's Encrypt certificate, so config.py
# points sslrootcert at a CA bundle that exists on whatever machine is running
# — certifi's, normally. An absolute path from someone else's checkout, or the
# gitignored cockroach-certs/ca.crt, both fail as a TLS error that reads like a
# certificate problem and is really a missing file.
#
# An sslrootcert that does exist is always left alone, so pinning your own CA
# still works. `sslmode` is never modified: verify-full stays verify-full.
COCKROACH_DATABASE_URL=postgresql://user:password@localhost:26257/brasstacks?sslmode=disable

# Cluster identity, used by the ccloud CLI setup scripts.
CCLOUD_CLUSTER_NAME=brasstacks

# --- The Ask agent, over CockroachDB's managed MCP server ---
# The owner asks a question; the agent answers it by querying the live cluster
# read-only. This is the second CockroachDB tool used at runtime.
#
# The token is a Cloud service account API key. Create the service account in
# the CockroachDB Cloud Console, scope its RBAC to this cluster, and copy the
# key out of the generated MCP config snippet. Read-only is the server default
# and we never grant write consent.
#
# The service account needs the Cloud RBAC role **Cluster Operator**, scoped to
# this cluster. Cluster Developer is NOT enough and fails quietly: the key
# authenticates fine (HTTP 200), the cluster list comes back empty, and the
# agent reports it cannot find any database. Check with:
#   curl -s https://cockroachlabs.cloud/api/v1/clusters \
#     -H "Authorization: Bearer $COCKROACH_MCP_TOKEN" | jq '.clusters | length'
#
# Leave the token blank and the nightly loop still runs — only Ask is disabled.
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_TOKEN=

# Not secrets — identifiers. Supplying them lets the Ask agent skip cluster and
# schema discovery, which it otherwise repeats on every single question.
# Measured against the live cluster: 8 tool calls per question without them,
# 2 with. Find the id via the curl above, or the Cloud Console URL.
COCKROACH_CLUSTER_ID=
COCKROACH_DATABASE=defaultdb

# --- AWS ---
AWS_REGION=us-east-1

# --- Reasoning model ---
# Which provider the agents reason through: "anthropic" (direct API) or
# "bedrock" (Claude hosted on Bedrock). Bedrock is unavailable on this account —
# see CLAUDE.md "Model access" — so the default is the direct API.
MODEL_PROVIDER=anthropic

# Direct Anthropic API. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-5

# Only used when MODEL_PROVIDER=bedrock. Note the `anthropic.` prefix — Bedrock
# model IDs are NOT the bare first-party IDs.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Embeddings, via boto3 bedrock-runtime. Titan is an AWS model, so no prefix.
# Output dimension must match VECTOR(1024) in db/schema.sql.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# Maker artifacts (menus, draft replies).
S3_ARTIFACT_BUCKET=brasstacks-artifacts-changeme

# --- Maker review email (first constrained execution tool) ---
# Disabled by default. When enabled, the completed Maker draft is sent to one
# server-configured owner/test inbox; the model cannot choose a recipient.
#
# Amazon SES identities are region-specific. In the SES sandbox, verify both
# the sender and the recipient in AWS_REGION before enabling this. Once the
# account has production access, only the sender identity must be verified.
MAKER_EMAIL_ENABLED=false
MAKER_EMAIL_FROM=
MAKER_REVIEW_EMAIL=virtual.icfd@gmail.com

# --- Demo tenant ---
# The single business the demo runs against. Populated by db/seed.
BRASSTACKS_BUSINESS_ID=

# Optional operator portfolio allowlist for the live Memory Engine endpoint.
# Comma-separated business UUIDs. When blank, the endpoint falls back to the
# single BRASSTACKS_BUSINESS_ID above. This is configuration, not a request
# parameter, so a public URL cannot be used to enumerate arbitrary tenants.
BRASSTACKS_OPERATOR_BUSINESS_IDS=

# --- Frontend API endpoints (build-time, not secrets) ---
# The site works as an honest local demo when these are blank. Do not expose a
# real onboarding write endpoint until it has operator/user authentication.
DECISION_API_ENDPOINT=
WORKFLOW_API_ENDPOINT=
ONBOARDING_API_ENDPOINT=

# --- Radar's outside-world signal ---
# A legitimate search API, since scraping review sites violates their ToS.
SEARCH_API_KEY=

# --- Yelp Fusion (opt-in: `python -m brasstacks.night --yelp`) ---
# Real reviews for a real business. Off by default for two reasons, and both
# are worth reading before you turn it on:
#
# 1. RETENTION IS CAPPED AT 24 HOURS. Yelp's API Terms of Use forbid storing
#    their content longer than that. Radar therefore deletes Yelp-sourced
#    observations older than 24h on every run. Yelp informs the night it is
#    seen and then goes — it never becomes the long memory the rest of the
#    product is built on. This is a licence term, not a tunable.
#
# 2. THE DEMO TENANT IS FICTIONAL. Rosa's Trattoria has no Yelp presence, so
#    this returns nothing for it. Pointing it at a real restaurant would drag
#    a business you do not own into a public submission.
#
# Also note Yelp returns 3 review excerpts truncated to 160 characters, chosen
# by their ranking — a trickle of recent sentiment, not a corpus.
YELP_API_KEY=

# --- Live competitor scouting (Google Places Nearby Search) ---
# Answers the Analyst's standing question "what are nearby restaurants charging,
# and is anyone else open for lunch?" — which until now had no live source at
# all. One call returns up to 20 nearby restaurants with rating, price level and
# today's opening hours.
#
# NOTHING FROM THIS IS STORED. Google's Places policy permits keeping place_id
# and nothing else, so the scan happens at reasoning time and goes straight into
# the Analyst's prompt. It is not a SignalSource and never becomes an
# observation — there is a test asserting that.
#
# Because there is no history, the prompt tells the Analyst these are today's
# numbers and must not be described as rising or falling.
#
# Cost: the Enterprise SKU (ratings + hours + price), free up to 10,000 calls
# per month. One nightly scan uses about 30. Google Cloud requires billing
# enabled even inside the free allowance.
#
# Leave the key blank and the night runs exactly as before, without competitor
# context. Point the coordinates at a real neighbourhood — the demo tenant is
# fictional, so scouting "around Rosa's" means picking somewhere real to look.
GOOGLE_MAPS_API_KEY=
PLACES_LATITUDE=
PLACES_LONGITUDE=
PLACES_RADIUS_M=1500
# Nearby Search returns the owner's own restaurant too; name it here so her own
# ratings are not fed back to her as a rival's.
PLACES_EXCLUDE_NAME=

# ---------------------------------------------------------------------------
# Sign in with Google (optional)
# ---------------------------------------------------------------------------
#
# Leave every value blank and the feature is simply off: the three /auth/google
# routes answer 404 and the sign-up page draws no button. Nothing else changes.
#
# To turn it on, create an OAuth 2.0 Client ID of type "Web application" in the
# Google Cloud console (APIs & Services -> Credentials) and paste its two values
# below. The consent screen needs only the default openid/email/profile scopes —
# this flow asks for identity and nothing else, so it does not need review.
#
# GOOGLE_OAUTH_REDIRECT_URI must match the "Authorized redirect URI" on the
# client *exactly*, including scheme, host, stage and trailing path: Google
# compares it as a string. Deployed, that value is the GoogleCallbackEndpoint
# output of the CloudFormation stack.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Signs the `state` parameter that carries the invite decision across the round
# trip to Google. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating it invalidates sign-ins that are mid-flight, and nothing else.
GOOGLE_OAUTH_STATE_SECRET=

# The invite code, checked by /register and by the Google flow alike. Blank
# means ungated — fine locally, not fine deployed: every active tenant costs a
# Tavily search, ~50 embeddings and a Claude call every night.
BRASSTACKS_INVITE_CODE=

# Where the OAuth callback sends the browser afterwards. Deployed this comes
# from SSM (the CloudFront domain); locally it is your dev server, e.g.
# http://127.0.0.1:8901
BRASSTACKS_SITE_URL=
