# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.

# --- CockroachDB (the memory layer) ---
# From the CockroachDB Cloud console, or `ccloud cluster sql-connection-string`.
# Format: postgresql://<user>:<password>@<host>:26257/<db>?sslmode=verify-full
COCKROACH_DATABASE_URL=postgresql://user:password@localhost:26257/brasstacks?sslmode=disable

# Cluster identity, used by the ccloud CLI setup scripts.
CCLOUD_CLUSTER_NAME=brasstacks

# --- AWS ---
AWS_REGION=us-east-1

# --- Reasoning model ---
# Which provider the agents reason through: "anthropic" (direct API) or
# "bedrock" (Claude hosted on Bedrock). Bedrock is unavailable on this account —
# see CLAUDE.md "Model access" — so the default is the direct API.
MODEL_PROVIDER=anthropic

# Direct Anthropic API. Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-opus-5

# Only used when MODEL_PROVIDER=bedrock. Note the `anthropic.` prefix — Bedrock
# model IDs are NOT the bare first-party IDs.
BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Embeddings, via boto3 bedrock-runtime. Titan is an AWS model, so no prefix.
# Output dimension must match VECTOR(1024) in db/schema.sql.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# Maker artifacts (menus, draft replies).
S3_ARTIFACT_BUCKET=brasstacks-artifacts-changeme

# --- Demo tenant ---
# The single business the demo runs against. Populated by db/seed.
BRASSTACKS_BUSINESS_ID=

# --- Radar's outside-world signal ---
# A legitimate search API, since scraping review sites violates their ToS.
SEARCH_API_KEY=
